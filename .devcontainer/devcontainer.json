// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "ts-qa",
	"build": {
		"dockerfile": "../.docker/Dockerfile",
		"context": "..",
		"args": {
			"COMPOSE_PROJ_NAME": "ts-qa",
			"KIND": "3.11",
		}
	},
	"mounts": [
		// "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/root/.gitconfig,type=bind,consistency=cached",
		"source=/storage-01/common-ts,target=/common-ts,type=bind,consistency=cached",
		//"source=/storage-02/common-repos,target=/common-repos,type=bind,consistency=cached,readonly"
	],
	"postCreateCommand": "huggingface-cli login --token $HF_TOKEN",
	"remoteUser": "root",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"tamasfe.even-better-toml",
				"github.copilot",
				"genieai.chatgpt-vscode",
				"ms-toolsai.jupyter",
				"mikestead.dotenv",
				"charliermarsh.ruff",
				"mechatroner.rainbow-csv",
				"ms-toolsai.datawrangler"
			]
		}
	},
	"runArgs": [
		"--gpus",
		"device=04",
		// "\"device=1,2\"",
		"--shm-size",
		"100G",
		// "--env-file",
		// "${localEnv:HOME}${localEnv:USERPROFILE}/.container_secrets",
		"--network",
	    "shared_net"
	]
}