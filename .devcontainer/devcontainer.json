// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "ts-qa",
	"build": {
		"dockerfile": "../.docker/Dockerfile",
		"context": "..",
		"args": {
			"COMPOSE_PROJ_NAME": "ts-qa",
			"KIND": "3.11"
		}
	},
	// mount HF_HOME to the container
	"mounts": [
		"source=${env:HF_HOME},target=/root/.cache/huggingface/,type=bind,consistency=cached",
		{
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.wandb_secret",
      "target": "/.wandb_secret",
      "type": "bind",
      "consistency": "ro",
      "optional": true
    },
	],
	"containerEnv": {
		"HF_HOME": "/root/.cache/huggingface/"
	},
	
	"remoteUser": "root",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"tamasfe.even-better-toml",
				"github.copilot",
				"genieai.chatgpt-vscode",
				"ms-toolsai.jupyter",
				"mikestead.dotenv",
				"ms-python.black-formatter"
			]
		}
	},
	"runArgs": [
		"--gpus",
		"device=0"
	]
}
