// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "ts-qa",
	"build": {
		"dockerfile": "../.docker/Dockerfile",
		"context": "..",
		"args": {
			"COMPOSE_PROJ_NAME": "ts-qa",
			"KIND": "3.11",
			"GITHUB_TOKEN": "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"
		}
	},
	// mount HF_HOME to the container
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/root/.gitconfig,type=bind,consistency=cached",
		// mount common-ts 
		"source=/storage-01/common-ts,target=/common-ts,type=bind,consistency=cached",
		// "source=${env:HF_HOME},target=/root/.cache/huggingface/,type=bind,consistency=cached",
		"source=/storage-02/common-repos,target=/common-repos,type=bind,consistency=cached"
	],
	
	"postCreateCommand": "huggingface-cli login --token $HF_TOKEN",
	"remoteUser": "root",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"tamasfe.even-better-toml",
				"github.copilot",
				"genieai.chatgpt-vscode",
				"ms-toolsai.jupyter",
				"mikestead.dotenv",
				"ms-python.black-formatter"
			]
		}
	},
	"runArgs": [
		"--gpus",
		"device=0",
		// "\"device=1,2\""
		"--shm-size",
		"50G",
		"--env-file",
		"${localEnv:HOME}${localEnv:USERPROFILE}/.container_secrets"
	]
}